# http | worker | relay | reconciler
PROCESS_ROLE=http
LOG_LEVEL=info
# человекочитаемые логи для разработки (pino-pretty — dev-зависимость)
LOG_PRETTY=false
PORT=4000
METRICS_PORT=9464
# порт метрик без авторизации: наружу не публиковать
METRICS_HOST=0.0.0.0

# только для локальной разработки: http-адрес Dokploy и cookie без Secure
DESTINATIONS_ALLOW_HTTP=false
SESSION_COOKIE_SECURE=true
# проверка токена и счёта клиента через T-Invest API; false — только разработка без сети и тесты:
# боевой режим, ротация токена и смена счёта боевого клиента тогда закрыты. На боевом стенде — только true
TINVEST_VERIFY_TOKENS=true
SESSION_TTL_HOURS=12
# сколько прокси перед api: за Dokploy/Traefik — 1; false — без прокси. true запрещён
TRUST_PROXY=false
# каталог роботов (templates/ и schema/); по умолчанию — ../bots в монорепо
# BOTS_CATALOG_DIR=

DATABASE_URL=postgres://botyard:botyard@localhost:55432/botyard
RABBITMQ_URL=amqp://botyard:botyard@localhost:55672
# живой статус в админке между процессами (SSE); без него — события только внутри процесса
REDIS_URL=redis://localhost:56379

# 32 байта в base64: openssl rand -base64 32
SECRETS_MASTER_KEY=
# адрес api, доступный из Dokploy, для вебхуков о сборке (без него — только опрос). Секрет — свой у назначения
# PUBLIC_API_URL=https://botyard.example.com
