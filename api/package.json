{
  "name": "@botyard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src",
    "test:int": "bun --env-file=.env.test test --preload ./test/integration/setup.ts test/integration",
    "migrate": "bun src/cli/migrate.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test:contract": "bun test test/contract",
    "operator:create": "bun src/cli/create-operator.ts",
    "catalog:sync": "bun src/cli/sync-catalog.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "handlebars": "^4.7.10",
    "kysely": "^0.29.9",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
