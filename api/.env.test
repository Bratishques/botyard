# Интеграционные тесты: только база с суффиксом _test (проверяется в test/integration/setup.ts)
DATABASE_URL=postgres://botyard:botyard@localhost:55432/botyard_test
LOG_LEVEL=fatal
# Фиксированный ключ только для тестов, ничего настоящего им не шифруется
SECRETS_MASTER_KEY=dGVzdC1vbmx5LW1hc3Rlci1rZXktMzItYnl0ZXMhISE=
# Тесты ходят по http
SESSION_COOKIE_SECURE=false
RABBITMQ_URL=amqp://botyard:botyard@localhost:55672
# Проверка токенов через T-Invest API выключена: тесты не ходят в сеть брокера (боевой режим тогда закрыт)
TINVEST_VERIFY_TOKENS=false
